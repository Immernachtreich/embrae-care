{%- if section.settings.text != blank -%}
  <div class="announce" role="region" aria-label="{{ 'general.announcement' | t }}" style="position:relative">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      {{ section.settings.text | escape }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "div",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "FREE SHIPPING ON ORDERS ABOVE ₹999" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Announcement bar" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
