{%- assign s = section.settings -%}
<section class="ing">
  <div class="wrap">
    <div class="sec-head reveal">
      <h2 class="h2">{{ s.heading | escape }}</h2>
      {%- if s.text != blank -%}
        {%- assign paras = s.text | newline_to_br | split: '<br />' -%}
        {%- for p in paras -%}
          {%- assign p = p | strip -%}
          {%- if p != blank %}<p class="lead">{{ p | escape }}</p>{% endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="ing-feature reveal">
      <div class="ing-vis">
        {%- if s.feature_image != blank -%}
          {{ s.feature_image | image_url: width: 1280 | image_tag: class: 'ing-art', loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw' }}
        {%- else -%}
          <div class="ing-art ek" role="img" aria-label="{{ s.animation_label | escape }}"><div class="ek-l ek-before"></div><div class="ek-l ek-after"></div><svg class="ek-fx" viewBox="0 0 640 280" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><linearGradient id="ekDg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".95"/><stop offset="1" stop-color="#62C0B0" stop-opacity=".95"/></linearGradient></defs><g transform="translate(294 126)"><g class="ek-rp"><circle r="80" fill="none" stroke="#C9F2E9" stroke-width="1.6"/></g><g class="ek-rp ek-rp2"><circle r="80" fill="none" stroke="#C9F2E9" stroke-width="1"/></g><g class="ek-d"><path d="M0 -15C7 -3 11 4 11 9a11 11 0 0 1 -22 0C-11 4 -7 -3 0 -15Z" fill="url(#ekDg)" stroke="#fff" stroke-opacity=".8"/></g></g><circle class="ek-sp" style="animation-delay:0s" cx="250" cy="92" r="2.4" fill="#fff"/><circle class="ek-sp" style="animation-delay:0.18s" cx="330" cy="104" r="1.8" fill="#fff"/><circle class="ek-sp" style="animation-delay:0.36s" cx="372" cy="140" r="2.2" fill="#fff"/><circle class="ek-sp" style="animation-delay:0.5s" cx="226" cy="150" r="1.6" fill="#fff"/><circle class="ek-sp" style="animation-delay:0.1s" cx="300" cy="178" r="2" fill="#fff"/><circle class="ek-sp" style="animation-delay:0.3s" cx="404" cy="98" r="1.6" fill="#fff"/></svg>
            {%- if s.chip_before != blank %}<div class="ek-chip ek-c1">{{ s.chip_before | escape }}</div>{% endif -%}
            {%- if s.chip_after != blank %}<div class="ek-chip ek-c2">{{ s.chip_after | escape }}</div>{% endif -%}
          </div>
        {%- endif -%}
      </div>
      <div class="ing-copy">
        {%- if s.feature_eyebrow != blank %}<p class="eyebrow">{{ s.feature_eyebrow | escape }}</p>{% endif -%}
        <h3>{{ s.feature_title | escape }}</h3>
        {%- if s.feature_text != blank %}<p>{{ s.feature_text | escape }}</p>{% endif -%}
      </div>
    </div>
    <div class="ing-keys reveal">
      {%- for block in section.blocks -%}
        <article class="ing-key" {{ block.shopify_attributes }}>
          <div class="iv">{% render 'home-icon', name: block.settings.icon %}</div>
          <h4>{{ block.settings.title | escape }}</h4>
          {%- if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif -%}
          {%- if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ 'sections.ingredients.learn_more' | t }}</a>{% endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- if s.button_label != blank -%}
      <div class="ing-cta reveal"><a class="btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ingredients feature",
  "tag": "div",
  "class": "section-ing",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Know what’s inside." },
    { "type": "textarea", "id": "text", "label": "Text", "info": "Each line becomes its own paragraph." },
    { "type": "header", "content": "Featured ingredient" },
    { "type": "image_picker", "id": "feature_image", "label": "Image", "info": "Replaces the Ectoin animation when set." },
    { "type": "text", "id": "animation_label", "label": "Animation description (screen readers)", "default": "Looping animation: a drop of Ectoin lands on dull, stressed skin and a hydrated, calm, resilient glow spreads across it" },
    { "type": "text", "id": "chip_before", "label": "Animation label, before", "default": "Dull and stressed" },
    { "type": "text", "id": "chip_after", "label": "Animation label, after", "default": "Hydrated and resilient" },
    { "type": "text", "id": "feature_eyebrow", "label": "Eyebrow", "default": "EMBRAE’S SIGNATURE INGREDIENT" },
    { "type": "text", "id": "feature_title", "label": "Title", "default": "ECTOIN" },
    { "type": "textarea", "id": "feature_text", "label": "Text" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore our ingredients →" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "ingredient", "name": "Ingredient", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "niacinamide", "options": [
        { "value": "niacinamide", "label": "Niacinamide" },
        { "value": "ceramides", "label": "Ceramides" },
        { "value": "hyaluronic", "label": "Hyaluronic Acid" },
        { "value": "panthenol", "label": "Panthenol" },
        { "value": "beta-glucan", "label": "Beta-Glucan" }
      ] },
      { "type": "text", "id": "title", "label": "Name", "default": "Niacinamide" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "url", "id": "link", "label": "“Learn more” link" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Ingredients feature", "blocks": [
    { "type": "ingredient", "settings": { "icon": "niacinamide", "title": "Niacinamide" } },
    { "type": "ingredient", "settings": { "icon": "ceramides", "title": "Ceramides" } },
    { "type": "ingredient", "settings": { "icon": "hyaluronic", "title": "Hyaluronic Acid" } },
    { "type": "ingredient", "settings": { "icon": "panthenol", "title": "Panthenol" } },
    { "type": "ingredient", "settings": { "icon": "beta-glucan", "title": "Beta-Glucan" } }
  ] }]
}
{% endschema %}
