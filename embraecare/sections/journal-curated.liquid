{%- assign s = section.settings -%}
{%- if s.style == 'most' -%}
  <section class="pg jr-most">
    <div class="wrap jr-mw">
      <div class="jr-mh reveal"><h2 class="h2">{{ s.heading | escape }}</h2>{% if s.text != blank %}<p class="lead2">{{ s.text | escape }}</p>{% endif %}</div>
      <ol class="jr-rank reveal">
        {%- for block in section.blocks -%}
          {%- assign a = block.settings.article -%}
          {%- if a == blank %}{% continue %}{% endif -%}
          <li style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}><a href="{{ a.url }}"><b>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</b><span class="jr-rt">{{ a.title | escape }}</span><span class="jr-rr">{{ a.metafields.embrae.read_time.value | escape }}</span><i class="jr-ar" aria-hidden="true">→</i></a></li>
        {%- endfor -%}
      </ol>
    </div>
  </section>
{%- else -%}
  <section class="jr-picked">
    <div class="wrap">
      <div class="sec-head reveal"><h2 class="h2">{{ s.heading | escape }}</h2>{% if s.text != blank %}<p class="lead2">{{ s.text | escape }}</p>{% endif %}</div>
      <div class="jr-pks reveal">
        {%- for block in section.blocks -%}
          {%- assign a = block.settings.article -%}
          {%- if a == blank %}{% continue %}{% endif -%}
          <a class="jr-pk" href="{{ a.url }}" style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}><div class="jr-pi"><i>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</i>{% render 'journal-thumb', post: a, ctx: 'pick' %}</div><div class="jr-pt"><small>{{ block.settings.label | escape }}</small><b>{{ a.title | escape }}</b><span class="jr-rd">{{ s.read_label | escape }}</span></div></a>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Journal: curated list",
  "tag": "div",
  "class": "section-journal-curated",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "default": "most", "options": [
      { "value": "most", "label": "Ranked list (Most read)" }, { "value": "picked", "label": "Picks with labels" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most read" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "read_label", "label": "Read link (picks)", "default": "Read the note →" }
  ],
  "blocks": [
    { "type": "article", "name": "Article", "settings": [
      { "type": "article", "id": "article", "label": "Article" },
      { "type": "text", "id": "label", "label": "Label (picks)" }
    ] }
  ],
  "max_blocks": 10,
  "enabled_on": { "templates": ["blog"] },
  "presets": [{ "name": "Journal: curated list" }]
}
{% endschema %}
