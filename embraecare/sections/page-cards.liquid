{%- liquid
  assign s = section.settings
  # One section for the About pages' card grids; the style picks the source markup.
-%}
<section class="pg{% if s.tint %} tint{% endif %}"{% if s.no_top %} style="padding-top:0"{% endif %}>
  <div class="wrap">
    {%- if s.heading != blank %}<div class="sec-head reveal"><h2 class="h2">{{ s.heading | escape }}</h2></div>{% endif -%}
    {%- case s.style -%}
      {%- when 'st4' -%}
        <div class="st4 reveal">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}><small>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</small><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p>{% if block.settings.link_label != blank %}<a href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label | escape }}</a>{% endif %}</div>
          {%- endfor -%}
        </div>
      {%- when 'mg' -%}
        <div class="mg reveal">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <div class="mt" {{ block.shopify_attributes }}>{% render 'ph-media', image: b.image, key: b.placeholder, tone: b.tone, label: b.image_label %}<h3>{{ b.title | escape }}</h3><p>{{ b.text | escape }}</p></div>
          {%- endfor -%}
        </div>
      {%- when 'pr' -%}
        <div class="pr-grid reveal" style="margin-top:0">
          {%- for block in section.blocks -%}
            <div class="pr" {{ block.shopify_attributes }}><span class="ic"><svg viewBox="0 0 100 200" aria-hidden="true"><use href="#leaf"/></svg></span><small>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</small><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div>
          {%- endfor -%}
        </div>
    {%- endcase -%}
    {%- if s.button_label != blank %}<div class="cta-c reveal"><a class="btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label | escape }}</a></div>{% endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Card grid",
  "tag": "div",
  "class": "section-cards",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "default": "pr", "options": [
      { "value": "pr", "label": "Principles (leaf icons)" },
      { "value": "st4", "label": "Routine steps (links)" },
      { "value": "mg", "label": "Moments (images)" }
    ] },
    { "type": "checkbox", "id": "tint", "label": "Tinted background", "default": false },
    { "type": "checkbox", "id": "no_top", "label": "No top padding", "default": false },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "text", "id": "link_label", "label": "Link label (routine steps)" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "image_picker", "id": "image", "label": "Image (moments)" },
      { "type": "text", "id": "image_label", "label": "Image description" },
      { "type": "text", "id": "placeholder", "label": "Placeholder illustration key" },
      { "type": "select", "id": "tone", "label": "Placeholder tone", "default": "a", "options": [
        { "value": "a", "label": "A" }, { "value": "b", "label": "B" }, { "value": "c", "label": "C" }, { "value": "d", "label": "D" }
      ] }
    ] }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Card grid" }]
}
{% endschema %}
