<section class="{{ section.settings.style }}">
  <div class="wrap">
    <div class="sec-head reveal"><h1 class="h1">{{ section.settings.heading | escape }}</h1>{% if section.settings.text != blank %}<p class="lead">{{ section.settings.text | escape }}</p>{% endif %}</div>
  </div>
</section>

{% schema %}
{
  "name": "Page intro",
  "tag": "div",
  "class": "section-page-intro",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "default": "ix-top", "options": [
      { "value": "ix-top", "label": "Ingredients" }, { "value": "fq-top", "label": "FAQs" }, { "value": "jr-top", "label": "Journal" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page title" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Page intro" }]
}
{% endschema %}
