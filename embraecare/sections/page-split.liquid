{%- assign s = section.settings -%}
<section class="split{% if s.wide %} w{% endif %}{% if s.reverse %} rev{% endif %} reveal">
  {% render 'ph-media', image: s.image, key: s.placeholder, tone: s.tone, label: s.image_label %}
  <div class="tx">
    {%- if s.eyebrow != blank %}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{% endif -%}
    {%- if s.heading != blank %}<h2 class="h2">{{ s.heading | escape }}</h2>{% endif -%}
    {{ s.text }}
    {%- if s.button_label != blank %}<a class="btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label | escape }}</a>{% endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "div",
  "class": "section-split",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_label", "label": "Image description" },
    { "type": "text", "id": "placeholder", "label": "Placeholder illustration key" },
    { "type": "select", "id": "tone", "label": "Placeholder tone", "default": "a", "options": [
      { "value": "a", "label": "A" }, { "value": "b", "label": "B" }, { "value": "c", "label": "C" }, { "value": "d", "label": "D" }
    ] },
    { "type": "checkbox", "id": "wide", "label": "Wide image", "default": false },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
