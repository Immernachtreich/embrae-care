{%- liquid
  assign s = section.settings
  assign price = product.selected_or_first_available_variant.price
  assign value = 0
  for p in product.metafields.embrae.routine_products.value
    assign value = value | plus: p.selected_or_first_available_variant.price
  endfor
  assign saving = value | minus: price
  if value > 0
    assign bar = price | times: 100.0 | divided_by: value | round: 1
  endif
-%}
<section class="pd-sec bd-why" id="why">
  <div class="wrap">
    <div class="sec-head reveal"><h2 class="h2">{{ s.heading | escape }}</h2>{% if s.text != blank %}<p class="lead">{{ s.text | escape }}</p>{% endif %}</div>
    <div class="bd-stage reveal">
      {%- for block in section.blocks -%}
        <div class="bd-sc" {{ block.shopify_attributes }}><svg class="bd-sp" viewBox="0 0 220 320" aria-hidden="true"><use href="#p-{{ block.settings.step }}"/></svg><div class="bd-nd"><i>{{ forloop.index }}</i></div><small>{{ block.settings.step | capitalize }}</small><b>{{ block.settings.title | escape }}</b><p>{{ block.settings.text | escape }}</p></div>
      {%- endfor -%}
    </div>
    <div class="bd-wk reveal">
      <div class="bd-k">
        <b class="kt">{{ s.routine_title | escape }}</b>
        <div class="bd-rt"><span><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="16" cy="16" r="5.5"/><path d="M16 3v4M16 25v4M3 16h4M25 16h4M7 7l2.8 2.8M22.2 22.2L25 25M7 25l2.8-2.8M22.2 9.8L25 7"/></svg></span><div class="bd-ds"><i style="--d:0.50s"></i><i style="--d:0.75s"></i><i style="--d:1.00s"></i><i style="--d:1.25s"></i></div><em>{{ s.morning | escape }}</em></div>
        <div class="bd-rt"><span><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M25 19.5A10.5 10.5 0 0 1 12.5 7a10.5 10.5 0 1 0 12.5 12.5z"/></svg></span><div class="bd-ds"><i style="--d:0.50s"></i><i style="--d:0.75s"></i><i style="--d:1.00s"></i></div><em>{{ s.night | escape }}</em></div>
        <p class="bd-rp">{{ s.routine_text | escape }}</p>
      </div>
      <div class="bd-k">
        <b class="kt">{{ s.ingredient_title | escape }}</b>
        {% render 'pdp-art-bundle', part: 'ectoin' %}
        <p>{{ s.ingredient_text | escape }}</p>
      </div>
      {%- if saving > 0 -%}
        <div class="bd-k bd-kv">
          <b class="kt">{{ s.value_title | escape }}</b>
          <div class="bd-bar"><span>{{ 'products.bought_separately' | t }}</span><div><i style="--w:100%"></i><b>{% render 'price', price: value %}</b></div></div>
          <div class="bd-bar bd-bb"><span>{{ 'products.this_routine' | t }}</span><div><i style="--w:{{ bar }}%"></i><b>{% render 'price', price: price %}</b></div></div>
          <p class="bd-sv">{{ 'products.you_save_label' | t }} <b>{% render 'price', price: saving %}</b></p>
          {%- if s.gift_text != blank -%}
            <div class="bd-pz"><svg viewBox="0 0 240 200" aria-hidden="true"><use href="#p-pouch"/></svg><p>{{ s.gift_text | escape }}</p></div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle: why choose",
  "tag": "div",
  "class": "section-bd-why",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why choose this routine?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Four essentials that work better together." },
    { "type": "header", "content": "Routine card" },
    { "type": "text", "id": "routine_title", "label": "Title", "default": "One simple routine" },
    { "type": "text", "id": "morning", "label": "Morning line", "default": "Morning, 4 steps" },
    { "type": "text", "id": "night", "label": "Night line", "default": "Night, 3 steps" },
    { "type": "text", "id": "routine_text", "label": "Text", "default": "Morning: Reset, Defend, Adapt, Protect. Night: Reset, Defend, Adapt." },
    { "type": "header", "content": "Ingredient card" },
    { "type": "text", "id": "ingredient_title", "label": "Title", "default": "Ingredient-focused" },
    { "type": "text", "id": "ingredient_text", "label": "Text", "default": "Hero ingredients in every product, with Ectoin in all four." },
    { "type": "header", "content": "Value card" },
    { "type": "paragraph", "content": "Prices and saving are calculated from the bundle price and its included products." },
    { "type": "text", "id": "value_title", "label": "Title", "default": "Better value together" },
    { "type": "text", "id": "gift_text", "label": "Gift line", "default": "Plus a complimentary Travel Pouch" }
  ],
  "blocks": [
    { "type": "card", "name": "Step card", "settings": [
      { "type": "select", "id": "step", "label": "Step", "default": "reset", "options": [
        { "value": "reset", "label": "Reset" }, { "value": "defend", "label": "Defend" },
        { "value": "adapt", "label": "Adapt" }, { "value": "protect", "label": "Protect" }
      ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Cleanse" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 4,
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Bundle: why choose" }]
}
{% endschema %}
