{%- liquid
  assign s = section.settings
  assign rating = product.metafields.reviews.rating.value
  assign count = product.metafields.reviews.rating_count.value | default: 0
-%}
<section class="pd-sec" id="reviews">
  <div class="wrap">
    <div class="sec-head reveal"><h2 class="h2">{{ s.heading | escape }}</h2>{% if s.text != blank %}<p class="lead">{{ s.text | escape }}</p>{% endif %}</div>
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' %}{% render block %}{% endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} Shell until a reviews app is added as an app block; reads Shopify's standard reviews metafields if an app fills them. {%- endcomment -%}
      <div class="rv-sum reveal">
        <div class="rv-l">
          <b>{% if rating %}{{ rating.rating | round: 1 }}{% else %}0.0{% endif %}</b>
          <div class="stars" aria-hidden="true">{% if rating %}{% assign full = rating.rating | round %}{% for i in (1..5) %}{% if i <= full %}★{% else %}☆{% endif %}{% endfor %}{% else %}☆☆☆☆☆{% endif %}</div>
          <small>{% if count > 0 %}{{ 'products.reviews_count' | t: count: count }}{% else %}{{ 'products.no_reviews' | t }}{% endif %}</small>
        </div>
        <div class="rv-r"><h3>{{ 'products.customer_photos' | t }}</h3>
          <div class="pgrid">{% for i in (1..4) %}<div class="pt"><svg class="c" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg></div>{% endfor %}</div>
          <p class="lay-note" style="text-align:left;margin-top:12px">{{ 'products.reviews_note' | t: title: product.title }}</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product: reviews",
  "tag": "div",
  "class": "section-pdp-reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real skin. Real experiences." },
    { "type": "text", "id": "text", "label": "Text", "default": "Honest reviews from the EMBRAE community." },
    { "type": "paragraph", "content": "Add your reviews app (Judge.me, Loox…) as an app block here. Until then a styled “No reviews yet” summary is shown." }
  ],
  "blocks": [{ "type": "@app" }],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Product: reviews" }]
}
{% endschema %}
