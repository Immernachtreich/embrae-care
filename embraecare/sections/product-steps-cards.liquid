<section class="pg tint">
  <div class="wrap">
    <div class="sec-head reveal"><h2 class="h2">{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<p class="lead" style="margin-top:14px">{{ section.settings.text | escape }}</p>{% endif %}</div>
    <div class="qs4 reveal">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- assign stp = p.metafields.embrae.step.value | default: 'reset' -%}
        <article class="qs-c" {{ block.shopify_attributes }}><div class="qs-fig"><svg viewBox="0 0 220 320" aria-hidden="true"><use href="#p-{{ stp }}"/></svg></div><div class="qs-b"><small>{{ stp | capitalize }}</small><b>{{ p.title | default: 'Choose a product' | escape }}</b><p>{{ block.settings.text | escape }}</p></div></article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product step cards",
  "tag": "div",
  "class": "section-qs4",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The four steps" },
    { "type": "text", "id": "text", "label": "Text" }
  ],
  "blocks": [
    { "type": "card", "name": "Product", "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Product step cards" }]
}
{% endschema %}
