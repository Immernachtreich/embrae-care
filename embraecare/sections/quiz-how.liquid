<section class="pg">
  <div class="wrap">
    <div class="sec-head reveal"><h2 class="h2">{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<p class="lead" style="margin-top:14px">{{ section.settings.text | escape }}</p>{% endif %}</div>
    <div class="qh-steps reveal">
      {%- for block in section.blocks -%}
        <div class="qh-step" {{ block.shopify_attributes }}><small>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</small><b>{{ block.settings.title | escape }}</b><p>{{ block.settings.text | escape }}</p></div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quiz: how it works",
  "tag": "div",
  "class": "section-quiz-how",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "text", "id": "text", "label": "Text" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Quiz: how it works" }]
}
{% endschema %}
