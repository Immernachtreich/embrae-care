<section class="quiz">
  <div class="wrap">
    {%- render 'step-icon', step: 'reset', class: 'qs a', style: 'height:150px' -%}
    {%- render 'step-icon', step: 'adapt', class: 'qs b', style: 'height:130px' -%}
    <h2 class="h2">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Quiz teaser",
  "tag": "div",
  "class": "section-quiz",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let’s find your routine." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Take the skin quiz →" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Link to the skin quiz page" }
  ],
  "presets": [{ "name": "Quiz teaser" }]
}
{% endschema %}
