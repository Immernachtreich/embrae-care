{%- assign s = section.settings -%}
<section class="sy-hero" id="top">
  <div class="wrap">
    {%- if s.eyebrow != blank %}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{% endif %}
    <h1>{{ s.heading | escape }}{% if s.subheading != blank %}<span>{{ s.subheading | escape }}</span>{% endif %}</h1>
    {%- if s.text != blank %}<p class="lead">{{ s.text | escape }}</p>{% endif -%}
    {%- if s.button_label != blank %}<div class="sy-acts"><a class="btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label | escape }}</a></div>{% endif -%}
  </div>
</section>

{% schema %}
{
  "name": "System: hero",
  "tag": "div",
  "class": "section-sy-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The EMBRAE System" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four steps." },
    { "type": "text", "id": "subheading", "label": "Second line" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "text", "id": "button_link", "label": "Button link", "info": "A page URL or an anchor such as #reset" }
  ],
  "presets": [{ "name": "System: hero" }]
}
{% endschema %}
