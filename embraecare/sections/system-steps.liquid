<div class="sy-steps" id="system">
  <nav class="sy-bar" aria-label="{{ section.settings.nav_label | escape }}"><ul>
    {%- for block in section.blocks -%}
      <li><a href="#{{ block.settings.step }}" data-for="{{ block.settings.step }}"><b>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</b>{{ block.settings.step | capitalize }}</a></li>
    {%- endfor -%}
  </ul></nav>
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign name = b.step | capitalize
      assign alt = forloop.index | modulo: 2
      assign next = section.blocks[forloop.index]
    -%}
    <section class="sy-sec{% if alt == 0 %} alt flip{% endif %}" id="{{ b.step }}" style="--t1:{{ b.tint_1 }};--t2:{{ b.tint_2 }}" aria-labelledby="h-{{ b.step }}" {{ block.shopify_attributes }}>
      <div class="wrap">
        <div class="gr">
          <div class="vis reveal" aria-hidden="true"><span class="num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span><div class="big">{% render 'step-icon', step: b.step, class: 'sy-ic', bare: true %}</div><div class="cap"><b>{{ name }}</b><small>{{ b.tag | escape }}</small></div></div>
          <div class="ct reveal">
            <p class="eyebrow">{{ 'sections.system.step_of' | t: index: forloop.index, count: forloop.length }}</p>
            <h2 id="h-{{ b.step }}">{{ name }}</h2>
            <p class="tag">{{ b.tag | escape }}</p>
            {%- if b.role != blank %}<p class="role">{{ b.role | escape }}</p>{% endif %}
            <div class="glance"><div><small>{{ 'sections.system.feels_like' | t }}</small><b>{{ b.feels | escape }}</b></div><div><small>{{ 'sections.system.use' | t }}</small><b>{{ b.use | escape }}</b></div><div><small>{{ 'sections.system.where' | t }}</small><b>{{ b.fits | escape }}</b></div></div>
            {%- if b.points != blank -%}
              <h4>{{ 'sections.system.what_it_does' | t }}</h4>
              <ul class="pts">{% assign lines = b.points | newline_to_br | split: '<br />' %}{% for l in lines %}{% assign l = l | strip %}{% if l != blank %}<li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{{ l | escape }}</li>{% endif %}{% endfor %}</ul>
            {%- endif -%}
            {%- if b.ingredients != blank -%}
              <h4>{{ 'sections.system.ingredients' | t }}</h4>
              <div class="ings">{% assign lines = b.ingredients | newline_to_br | split: '<br />' %}{% for l in lines %}{% assign parts = l | strip | split: '|' %}{% if parts.size > 0 %}<div class="ing"><b>{{ parts[0] | strip | escape }}</b><p>{{ parts[1] | strip | escape }}</p></div>{% endif %}{% endfor %}</div>
            {%- endif -%}
            {%- if b.how != blank -%}
              <h4>{{ 'products.how_to_use' | t }}</h4>
              <ol class="how">{% assign lines = b.how | newline_to_br | split: '<br />' %}{% for l in lines %}{% assign l = l | strip %}{% if l != blank %}<li>{{ l | escape }}</li>{% endif %}{% endfor %}</ol>
            {%- endif -%}
            {%- if b.note != blank %}<p class="note">{{ b.note | escape }}</p>{% endif -%}
            {%- if b.idea != blank %}<div class="idea"><small>{{ 'sections.system.idea' | t: step: name }}</small><p>{{ b.idea | escape }}</p></div>{% endif -%}
            {%- if b.product != blank %}<div class="sy-buy"><a class="btn" href="{{ b.product.url }}">{{ 'sections.system.shop' | t: title: b.product.title }}</a></div>{% endif -%}
          </div>
        </div>
        {%- if next -%}
          {%- assign next_name = next.settings.step | capitalize -%}
          <a class="nxt" href="#{{ next.settings.step }}" aria-label="{{ 'sections.system.next_label' | t: step: next_name }}">{{ 'sections.system.next' | t: step: next_name }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15M6 13l6 6 6-6"/></svg></a>
        {%- elsif section.settings.final_label != blank -%}
          <a class="nxt" href="{{ section.settings.final_link | default: '#routine' }}" aria-label="{{ section.settings.final_label | escape }}">{{ section.settings.final_label | escape }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15M6 13l6 6 6-6"/></svg></a>
        {%- endif -%}
      </div>
    </section>
  {%- endfor -%}
</div>

{% javascript %}
  (function () {
    // Sticky step bar: track header height and highlight the step in view.
    function init() {
      var bar = document.querySelector('.sy-bar'); if (!bar || bar._spy) return; bar._spy = true;
      var hd = document.querySelector('.header'), links = [].slice.call(bar.querySelectorAll('a')), secs = [].slice.call(document.querySelectorAll('.sy-sec'));
      function hh() { document.documentElement.style.setProperty('--hh', (hd ? hd.getBoundingClientRect().height : 72) + 'px'); }
      function spy() {
        var y = (hd ? hd.getBoundingClientRect().height : 72) + 54 + Math.round(window.innerHeight * .25), cur = null;
        secs.forEach(function (s) { var r = s.getBoundingClientRect(); if (r.top <= y && r.bottom > y) cur = s.id; });
        links.forEach(function (a) { var on = a.getAttribute('data-for') === cur; a.classList.toggle('on', on); if (on) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); });
      }
      hh(); spy();
      window.addEventListener('resize', function () { hh(); spy(); });
      window.addEventListener('scroll', spy, { passive: true });
    }
    document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('shopify:section:load', init);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "System: steps",
  "tag": "div",
  "class": "section-sy-steps",
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Step bar label (screen readers)", "default": "The four steps" },
    { "type": "text", "id": "final_label", "label": "Link after the last step", "default": "Complete your routine" },
    { "type": "text", "id": "final_link", "label": "Its link", "default": "#routine" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "select", "id": "step", "label": "Step", "default": "reset", "options": [
        { "value": "reset", "label": "Reset" }, { "value": "defend", "label": "Defend" },
        { "value": "adapt", "label": "Adapt" }, { "value": "protect", "label": "Protect" }
      ] },
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "text", "id": "tag", "label": "Role name", "default": "Cleanse & Prepare" },
      { "type": "textarea", "id": "role", "label": "Role description" },
      { "type": "text", "id": "feels", "label": "Feels like" },
      { "type": "text", "id": "use", "label": "Use" },
      { "type": "text", "id": "fits", "label": "Where it fits" },
      { "type": "textarea", "id": "points", "label": "What it does", "info": "One point per line" },
      { "type": "textarea", "id": "ingredients", "label": "Ingredients", "info": "One per line: Name | description" },
      { "type": "textarea", "id": "how", "label": "How to use", "info": "One step per line" },
      { "type": "text", "id": "note", "label": "Note" },
      { "type": "textarea", "id": "idea", "label": "The idea behind it" },
      { "type": "color", "id": "tint_1", "label": "Background tint 1", "default": "#E4F3EF" },
      { "type": "color", "id": "tint_2", "label": "Background tint 2", "default": "#F6E6DD" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "System: steps" }]
}
{% endschema %}
