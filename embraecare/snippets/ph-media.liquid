{% doc %}
  Image slot from the source design: the chosen image, or the page's placeholder illustration until one is set.

  @param {image} [image] - Image picked in the theme editor
  @param {string} [key] - Placeholder illustration key (snippets/ph-art.liquid)
  @param {string} [tone] - Placeholder tone class a, b, c or d
  @param {string} [label] - Description for screen readers
{% enddoc %}
<div class="ph sc {{ tone | default: 'a' }}" data-label="{{ label | escape }}" role="img" aria-label="{{ image.alt | default: label | escape }}">
  {%- if image != blank -%}
    {{ image | image_url: width: 2000 | image_tag: alt: '', sizes: '(min-width: 990px) 50vw, 100vw', class: 'ph-img', loading: 'lazy' }}
  {%- else -%}
    {% render 'ph-art', key: key %}
  {%- endif -%}
</div>
{% stylesheet %}
  .ph > .ph-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
{% endstylesheet %}
