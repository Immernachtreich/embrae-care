      "type": "page-split",
      "settings": {
        "placeholder": "our-story-3",
        "tone": "d",
        "image_label": "Lifestyle: care within daily life",
        "wide": false,
        "reverse": true,
        "eyebrow": "",
        "heading": "",
        "text": "<p>EMBRAE began with one simple intention: to make everyday skincare easier to live with.</p><p>Not by asking people to do more. But by helping them understand what matters. By creating products with a clear purpose. By building a routine that feels natural to follow. And by making space for something that is often overlooked: the feeling of taking care of yourself.</p><p>That is why EMBRAE is a routine first, and a collection of products second. Four steps, each with a clear role, so there is less to figure out and more room to simply care for yourself.</p>",
        "button_label": "",
        "button_link": ""
      }
